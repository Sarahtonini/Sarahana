                padx=20,
                pady=5
            )

        else:

            ctk.CTkLabel(
                readings,
                text="💧 Water: No reading yet",
                font=font(15),
                text_color=PAL["muted"]
            ).pack(
                anchor="w",
                padx=20,
                pady=5
            )



    def latest(self, kind):

        values = [
            x
            for x in self.data["usage"]
            if x["kind"] == kind
        ]

        if not values:
            return None

        return values[-1]["value"]



    def complete_action(self):

        today = dt.date.today().isoformat()

        if today not in self.data["eco_actions"]:

            self.data["eco_actions"].append(
                today
            )

            save(self.data)

        self.show("Overview")


    def get_streak(self):

        dates = set()

        for d in self.data["eco_actions"]:

            try:

                dates.add(
                    dt.date.fromisoformat(d)
                )

            except ValueError:

                pass

        streak = 0

        day = dt.date.today()

        while day in dates:

            streak += 1

            day -= dt.timedelta(days=1)

        return streak



