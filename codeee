    def add_food(
        self,
        name_entry,
        date_entry,
        message
    ):

        name = name_entry.get().strip()
        date_text = date_entry.get().strip()

        if not name:

            message.configure(
                text="Please enter a food name."
            )

            return

        try:

            d = dt.date.fromisoformat(
                date_text
            )

        except ValueError:

            message.configure(
                text="Use the format YYYY-MM-DD."
            )

            return

        self.data["food"].append(
            {
                "name": name,
                "expires": d.isoformat()
            }
        )

        save(self.data)

        self.show("Kitchen")


   

    def resolve_food(
        self,
        item,
        eaten
    ):

        self.data["food"].remove(item)

        if eaten:

            self.data["eaten"] += 1

        else:

            self.data["wasted"] += 1

        save(self.data)

        self.show("Kitchen")



