FONT = "Helvetica"


def pick_font():
    

    have = set(tkfont.families())

    for name in (
        "Avenir Next",
        "Poppins",
        "SF Pro Display",
        "Helvetica Neue",
        "Noto Sans",
        "DejaVu Sans",
    ):
        if name in have:
            return name

    return "Helvetica"


def font(size, weight="normal"):
    return ctk.CTkFont(
        family=FONT,
        size=size,
        weight=weight
    )




def load():
    

    base = {
        "food": [],
        "eaten": 0,
        "wasted": 0,
        "usage": [],
        "goals": {
            "food_target": 10
        },
        "eco_actions": []
    }

    try:
        saved = json.loads(DATA_FILE.read_text())

        base.update(saved)

        if "goals" not in base:
            base["goals"] = {}

        if "food_target" not in base["goals"]:
            base["goals"]["food_target"] = 10

        if "eco_actions" not in base:
            base["eco_actions"] = []

        if "food" not in base:
            base["food"] = []

        if "usage" not in base:
            base["usage"] = []

    except (OSError, ValueError, json.JSONDecodeError):
        pass

    return base


def save(data):
    try:
        DATA_FILE.write_text(
            json.dumps(data, indent=2)
        )
    except OSError:
        pass


def days_left(iso):
    return (
        dt.date.fromisoformat(iso) - dt.date.today()
    ).days


def expiry_text(n):
    if n < 0:
        return "Expired"
    elif n == 0:
        return "Expires today"
    elif n == 1:
        return "Expires tomorrow"
    else:
        return f"Expires in {n} days"



